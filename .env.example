# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
# Clé service_role (Project Settings → API) — secret serveur uniquement, jamais exposé au
# client. Utilisée uniquement par le webhook Stripe pour écrire en base sans session utilisateur.
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# URL publique du site, utilisée pour le lien de callback du magic link et les redirections Stripe
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Dashboard → Developers → API keys / Webhooks / Product catalog)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_STARTER_PRICE_ID=price_xxxxx
STRIPE_PRO_PRICE_ID=price_xxxxx

# Resend (resend.com/api-keys) — email de suivi après le diagnostic
RESEND_API_KEY=re_xxxxx
# Optionnel : sans domaine vérifié sur Resend, garde onboarding@resend.dev (n'envoie qu'à
# l'adresse du compte Resend). Une fois un domaine vérifié (Resend → Domains), mets-le ici.
# EMAIL_FROM=NIS2Ready <contact@tondomaine.fr>
